# Copia a .env.local (no se versiona) o define estas variables en Vercel.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...clave-anon-publica
# true (por defecto): exige iniciar sesión con un usuario de Supabase Auth.
# false: acceso sin login (solo piloto; requiere las políticas anon).
VITE_REQUIRE_LOGIN=true
